@{
    ViewData["Title"] = "Import Excel";
}

<h2>Import Sinh Viên</h2>

@if (ViewBag.Message != null)
{
    <div style="color:green">@Html.Raw(ViewBag.Message)</div>
}

<form asp-action="Import" method="post" enctype="multipart/form-data">
    <input type="file" name="file" accept=".xlsx" />
    <br /><br />
    <button type="submit">Import</button>

    <a asp-controller="Student" asp-action="Index" class="btn btn-secondary">
        Quay lại
    </a>
</form>