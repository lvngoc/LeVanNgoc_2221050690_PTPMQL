@model List<FirstWebMVC.Models.Entities.Student>

<h2>Danh sach Sinh vien</h2> 
<button type="button" class="btn btn-info mb-3" onclick="showSearch()">
    Tìm kiếm
</button>

<div id="searchBox" style="display:none; margin-bottom:15px;">
    <form asp-action="Index" method="get">
        <input type="text"
               name="searchString"
               class="form-control"
               placeholder="Nhập đầy đủ MSV hoặc họ tên..."
               style="width:300px; display:inline-block;" />

        <button type="submit" class="btn btn-primary">
            Tìm
        </button>
    </form>
</div>

<table class="table table-bordered">
    <tr>
        <th>Ma SV</th>
        <th>Ho Ten SV</th>
        <th>Email</th>
        <th>Actions</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.StudentCode</td>
            <td>@item.FullName</td>
            <td>@item.Email</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
            </td>
        </tr>
    }
</table>
<a asp-controller="Student"
   asp-action="Create"
   class="btn btn-primary"
   style="margin-bottom: 10px;">
    Thêm sinh viên
</a>   
<script>
    function showSearch() {
        var box = document.getElementById("searchBox");
        box.style.display = "block";
    }
</script>